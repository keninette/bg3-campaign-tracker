---
import "../styles/book.css";

interface Props {
  title: string;
  eyebrow: string;
  home?: boolean;
}

const { title, eyebrow, home = false } = Astro.props;
const summaryUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta
      name="description"
      content="Chroniques et souvenirs d'une aventure sur la Côte des Épées."
    />
  </head>
  <body>
    <main class="book-page">
      <svg
        class="paper-stains"
        viewBox="0 0 800 1000"
        preserveAspectRatio="xMidYMin slice"
        aria-hidden="true"
      >
        <defs>
          <filter id="aging" filterUnits="userSpaceOnUse" x="0" y="0" width="800" height="1000">
            <feTurbulence type="fractalNoise" baseFrequency="0.006 0.01" numOctaves="5" seed="2" />
            <feColorMatrix values="0 0 0 0 0.45 0 0 0 0 0.3 0 0 0 0 0.12 0 0 0 1.3 -0.5" />
          </filter>
          <filter id="ring" filterUnits="userSpaceOnUse" x="0" y="0" width="800" height="1000">
            <feTurbulence type="fractalNoise" baseFrequency="0.025" numOctaves="4" seed="4" result="n" />
            <feDisplacementMap in="SourceGraphic" in2="n" scale="26" />
            <feGaussianBlur stdDeviation="1.1" />
          </filter>
          <filter id="blood" filterUnits="userSpaceOnUse" x="0" y="0" width="800" height="1000">
            <feTurbulence type="fractalNoise" baseFrequency="0.06" numOctaves="3" seed="9" result="n" />
            <feDisplacementMap in="SourceGraphic" in2="n" scale="10" />
            <feGaussianBlur stdDeviation="0.6" />
          </filter>
        </defs>
        <rect width="800" height="1000" filter="url(#aging)" opacity="0.55" />
        <g filter="url(#ring)">
          <circle cx="650" cy="210" r="88" fill="#8b5a2b" fill-opacity="0.1" stroke="#6f4520" stroke-width="7" stroke-opacity="0.32" />
          <circle cx="170" cy="800" r="56" fill="#8b5a2b" fill-opacity="0.08" stroke="#6f4520" stroke-width="5" stroke-opacity="0.26" />
          <circle cx="215" cy="770" r="40" fill="none" stroke="#6f4520" stroke-width="3" stroke-opacity="0.16" />
        </g>
        <g filter="url(#blood)" fill="#700f0f" fill-opacity="0.5">
          <circle cx="690" cy="720" r="17" />
          <circle cx="722" cy="758" r="7" />
          <circle cx="668" cy="765" r="4" />
          <circle cx="735" cy="690" r="3" />
          <ellipse cx="705" cy="800" rx="3" ry="9" />
        </g>
      </svg>

      <header class="book-header">
        <p class="eyebrow">{eyebrow}</p>
        <h1>
          {
            home ? (
              "Contes et légendes de la Côte des épées"
            ) : (
              <a class="title-link" href={summaryUrl} title="Retour au sommaire">
                Contes et légendes de la Côte des épées
              </a>
            )
          }
        </h1>
        <div class="ornament" aria-hidden="true">✦</div>
      </header>

      <slot />
    </main>
  </body>
</html>
