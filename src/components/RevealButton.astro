---
interface Props {
  // Path of the Markdown file in the repository, e.g. src/content/lore/zhentarim.md
  path: string;
  available: boolean;
}

const { path, available } = Astro.props;
---
<reveal-button class="reveal" data-path={path} data-available={String(available)}>
  <button type="button">{available ? "Masquer aux joueurs" : "Révéler aux joueurs"}</button>
  <span class="reveal-status" role="status"></span>
</reveal-button>

<script>
  import "../scripts/reveal-button";
</script>
