---
import { render } from "astro:content";
import { Image } from "astro:assets";
import BookLayout from "../layouts/BookLayout.astro";
import {
  getSessionNumbers,
  getSessionTexts,
  sessionUrl,
} from "../lib/sessions";

interface Props {
  session: number;
}

const { session } = Astro.props;
const texts = await getSessionTexts(session);
const rendered = await Promise.all(
  texts.map(async (text) => ({ text, ...(await render(text)) })),
);

// Sessions are sorted from newest to oldest.
const sessions = await getSessionNumbers();
const index = sessions.indexOf(session);
const newer = index > 0 ? sessions[index - 1] : undefined;
const older = index < sessions.length - 1 ? sessions[index + 1] : undefined;

async function firstTitle(target: number | undefined) {
  if (target === undefined) return undefined;
  const [first] = await getSessionTexts(target);
  return first?.data.title;
}
const newerTitle = await firstTitle(newer);
const olderTitle = await firstTitle(older);
---
<BookLayout
  title={`Contes et légendes de la Côte des Épées, Vol. XI · Chapitre ${session}`}
  eyebrow={`Chroniques de la Côte des Épées · Chapitre ${session}`}
>
  {
    rendered.map(({ text, Content }) => (
      <article class="chapter">
        <h2 class="chapter-label">{text.data.title}</h2>
        {text.data.picture && (
          <figure class="chapter-picture">
            <button type="button" data-enlarge aria-label={`Agrandir l'image : ${text.data.title}`}>
              <Image
                src={text.data.picture}
                alt={text.data.title}
                widths={[480, 800, 1200, 1800]}
                sizes="(max-width: 800px) 90vw, 40rem"
              />
            </button>
          </figure>
        )}
        <div class="chapter-body">
          <Content />
        </div>
      </article>
    ))
  }

  <nav class="book-nav" aria-label="Navigation entre les sessions">
    {
      older !== undefined ? (
        <a href={sessionUrl(older)} rel="prev">
          {olderTitle && <span class="book-nav-title">← {olderTitle}</span>}
        </a>
      ) : (
        <span />
      )
    }
    {
      newer !== undefined ? (
        <a href={sessionUrl(newer)} rel="next">
          {newerTitle && <span class="book-nav-title">{newerTitle} →</span>}
        </a>
      ) : (
        <span />
      )
    }
  </nav>

  <dialog class="picture-dialog" id="picture-dialog" aria-label="Image agrandie">
    <form method="dialog"><button>Fermer ✕</button></form>
    <img alt="" />
  </dialog>
</BookLayout>
<script>
  const dialog = document.querySelector<HTMLDialogElement>("#picture-dialog");
  const big = dialog?.querySelector("img");

  document.querySelectorAll<HTMLButtonElement>("[data-enlarge]").forEach((button) => {
    button.addEventListener("click", () => {
      const img = button.querySelector("img");
      if (!dialog || !big || !img) return;
      big.alt = img.alt;
      big.srcset = img.srcset;
      big.sizes = "96vw";
      big.src = img.currentSrc || img.src;
      dialog.showModal();
    });
  });

  // Clicking the backdrop closes the dialog
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
