---
import BookLayout from "../layouts/BookLayout.astro";
import "../styles/summary.css";
import {
  getSessionNumbers,
  getSessionTexts,
  homeUrl,
  sessionUrl,
} from "../lib/sessions";

// Book order: oldest session first. Page numbers are estimated from word count
// and run continuously across sessions.
const WORDS_PER_PAGE = 300;
const sessionNumbers = (await getSessionNumbers()).reverse();
let page = 1;
const sections = [];
for (const session of sessionNumbers) {
  const texts = (await getSessionTexts(session)).map((text) => {
    const start = page;
    const words = (text.body ?? "").split(/\s+/).filter(Boolean).length;
    page += Math.max(1, Math.ceil(words / WORDS_PER_PAGE));
    return { text, page: start };
  });
  sections.push({ session, texts });
}
---
<BookLayout
  title="Contes et légendes de la Côte des Épées, Vol. XI · Sommaire"
  eyebrow="Sommaire"
  breadcrumb={[{ label: "Sommaire" }]}
>
  <p class="summary-intro">
    Ce vieux livre en cuir est la première édition du livre à succès qui relate les aventures d'un groupe de héros dans leur voyage pour se débarrasser de la larve Illithid qui les infectait. Il est composé des originaux collectés par un inconnu, probablement leur contemporain, durant tout leur voyage.
    Les pages sont reliées maladroitement avec de fines lanières en cuir, elles sont jaunies, presque brunies par le temps.
  </p>
  <nav class="toc" aria-label="Sommaire">
    {
      sections.map(({ session, texts }) => (
        <section class="toc-session">
          <h2 class="toc-session-title">
            <a href={sessionUrl(session)}>Chapitre {session}</a>
          </h2>
          <ul>
            {texts.map(({ text, page }) => (
              <li>
                <div class="toc-entry">
                  <span>{text.data.title}</span>
                  <span class="toc-leader" aria-hidden="true" />
                  <span class="toc-page">{page}</span>
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </nav>

  <nav class="book-nav" aria-label="Navigation">
    <a href={homeUrl}>
      <span class="book-nav-title">← Retour à l'accueil</span>
    </a>
  </nav>
</BookLayout>
