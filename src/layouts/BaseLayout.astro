---
import "../styles/base.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Chroniques et souvenirs d'une aventure sur la Côte des Épées.",
} = Astro.props;
---
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>