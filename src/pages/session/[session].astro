---
import SessionPage from "../../components/SessionPage.astro";
import { getSessionNumbers } from "../../lib/sessions";

export async function getStaticPaths() {
  const sessions = await getSessionNumbers();
  return sessions.map((session) => ({
    params: { session: String(session) },
    props: { session },
  }));
}

const { session } = Astro.props;
---
<SessionPage session={session} />
