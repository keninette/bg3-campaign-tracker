---
import BookLayout from "../layouts/BookLayout.astro";
import DeskInk from "../components/DeskInk.astro";
import { pageUrl } from "../lib/sessions";
---
<BookLayout
  desk
  title="Contes et légendes de la Côte des épées"
>
  <h1 class="sr-only">Contes et légendes de la Côte des épées</h1>
  <div class="desk">
    <a class="tome" href={pageUrl("sommaire")}>
      <span class="tome-band" aria-hidden="true"></span>
      <span class="tome-title">Contes et légendes de la Côte des Épées</span>
      <span class="tome-ornament" aria-hidden="true">✦</span>
      <span class="tome-volume">Vol. XI</span>
      <span class="tome-band tome-band-low" aria-hidden="true"></span>
    </a>

    <a class="folder" href={pageUrl("extraits")}>
      <span class="folder-papers" aria-hidden="true">
        <span class="sheet sheet-1"></span>
        <span class="sheet sheet-2"></span>
        <span class="sheet sheet-3"></span>
      </span>
      <span class="folder-cover">
        <span class="folder-strap" aria-hidden="true"></span>
        <span class="folder-note">Extraits</span>
      </span>
    </a>

    <DeskInk />
  </div>
</BookLayout>
