---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/index.css";
import { pageUrl } from "../lib/sessions";
---
<BaseLayout title="Contes et légendes de la Côte des épées">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&display=swap"
      rel="stylesheet"
    />
  </Fragment>
  <main>
    <a href={pageUrl("sommaire")}>Contes et légendes de la Côte des Épées, Vol. XI</a>
    <a href={pageUrl("extraits")}>Lore</a>
  </main>
</BaseLayout>
